# ── Asosiy ──
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/abu_tolib
WEB_URL=http://localhost:3000

# ── JWT / cookie ──
# Yaratish: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ── Telegram bot (@BotFather) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Admin bo'ladigan raqamlar, vergul bilan (faqat raqamlar)
ADMIN_PHONES=998901234567
LOGIN_REQUEST_TTL_MIN=10

# ── Ishlab chiqish ──
# Botsiz kirish (faqat lokal; production'da avtomatik o'chadi)
AUTH_DEV_LOGIN=true
SWAGGER_ENABLED=true
